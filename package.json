{
  "name": "denuncia-rapida",
  "version": "0.1.0",
  "description": "Automated parking violation reporter for Buenos Aires",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "node --test",
    "install-app": "bash scripts/install-app.sh",
    "install-autostart": "bash scripts/install-autostart.sh",
    "uninstall-autostart": "bash scripts/install-autostart.sh --uninstall",
    "icon": "bash scripts/build-icon.sh",
    "dist": "electron-builder --mac --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "baileys": "^7.0.0-rc14",
    "exifreader": "^4.14.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "keywords": [
    "buenos-aires",
    "parking",
    "whatsapp",
    "automation"
  ],
  "author": "Damián",
  "license": "MIT",
  "build": {
    "appId": "vg.tlon.denunciarapida",
    "productName": "Denuncia Rápida",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Denuncia Rápida"
    }
  }
}
